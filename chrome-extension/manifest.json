{
  "manifest_version": 3,
  "name": "AutoApply AI — LinkedIn Job Scraper",
  "version": "1.0.1",
  "description": "Scrape jobs from LinkedIn and send them to AutoApply AI for batch tailoring.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://www.linkedin.com/*", "https://*.vercel.app/*", "http://localhost:3000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["https://*.vercel.app/pipeline*", "http://localhost:3000/pipeline*"],
      "js": ["pipeline-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
